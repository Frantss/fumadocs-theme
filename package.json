{
  "name": "@frantss/fumadocs-theme",
  "version": "0.1.0",
  "type": "module",
  "description": "Geist Mono theme and layout components for Fumadocs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frantss/fumadocs-theme.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/ssr.test.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0"
  },
  "peerDependencies": {
    "fumadocs-ui": "^16.17.8",
    "react": "^19.2.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "homepage": "https://github.com/Frantss/fumadocs-theme#readme",
  "bugs": {
    "url": "https://github.com/Frantss/fumadocs-theme/issues"
  }
}
